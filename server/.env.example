# The Vercel AI Gateway key. Locally in .env.local (never committed); on
# Vercel, OIDC needs no key once the project is linked.
AI_GATEWAY_API_KEY=
# The model that reads the words, as a Gateway slug.
VIBE_MODEL=openai/gpt-6-luna
# Tried in order when it fails.
VIBE_FALLBACK_MODELS=anthropic/claude-haiku-4.5
